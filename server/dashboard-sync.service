[Unit]
Description=Dashboard sync service (SQLite, local only; Tailscale serves it to Shahar's devices)
After=network.target

[Service]
WorkingDirectory=%h/dashboard
ExecStart=/usr/bin/env node server/app.mjs
Environment=DASH_PORT=8787
Environment=DASH_DB=%h/.openclaw/workspace/data/life.db
Environment=DASH_ORIGINS=https://shaharburg1010-bot.github.io
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
